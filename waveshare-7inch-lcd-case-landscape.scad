/**
 * Waveshare 7-inch LCD + Raspberry Pi Case - Landscape
 *
 * Closed two-part enclosure: LCD in a removable lid, Raspberry Pi on the solid
 * base floor behind it, and five localized 10 mm cable passages.
 * Change lcd_angle_from_table_deg to regenerate base depth and rear height.
 */

case_layout = "landscape";
lcd_angle_from_table_deg = 35;
part = "assembly";
render_mode = "assembly";

include <waveshare-7inch-lcd-case-common.inc>
