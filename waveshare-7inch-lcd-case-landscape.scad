/**
 * Waveshare 7-inch LCD + Raspberry Pi Case - Landscape
 *
 * One source 254 x 133.35 mm display panel in landscape orientation with a
 * right-side connector/Pi service bay and an open-back wedge stand.
 * Change lcd_angle_from_table_deg to regenerate the required case depth.
 */

case_layout = "landscape";
lcd_angle_from_table_deg = 35;
render_mode = "assembly";

include <waveshare-7inch-lcd-case-common.inc>
